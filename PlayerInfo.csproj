<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PlayerInfo</AssemblyName>
    <RootNamespace>PlayerInfo</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpModBase\CSharpModBase.csproj">
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BtlSvr.Main">
      <HintPath>..\GameDll\BtlSvr.Main.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="b1.Native">
      <HintPath>..\GameDll\b1.Native.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="b1.NativePlugins">
      <HintPath>..\GameDll\b1.NativePlugins.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GSE.Core">
      <HintPath>..\GameDll\GSE.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Diana.Common">
      <HintPath>..\GameDll\Diana.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>..\GameDll\Google.Protobuf.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GSE.ProtobufDB">
      <HintPath>..\GameDll\GSE.ProtobufDB.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Protobuf.RunTime">
      <HintPath>..\GameDll\Protobuf.RunTime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>..\GameDll\System.Memory.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UnrealEngine.Runtime">
      <HintPath>..\GameDll\UnrealEngine.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnrealEngine">
      <HintPath>..\GameDll\UnrealEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnrealEngine">
      <HintPath>..\GameDll\B1UI_GSE.Script.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 构建后自动部署：把产物 dll/pdb 复制到游戏里独立的 PlayerInfo Mod 目录。
       与 MagicMod 完全分离（独立文件夹 CSharpLoader\Mods\PlayerInfo\），互不覆盖。 -->
  <PropertyGroup>
    <GamePlayerInfoModDir>F:\game\steam\steamapps\common\BlackMythWukong\b1\Binaries\Win64\CSharpLoader\Mods\PlayerInfo</GamePlayerInfoModDir>
  </PropertyGroup>

  <Target Name="DeployPlayerInfoToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GamePlayerInfoModDir)"
          Condition="Exists('$(GamePlayerInfoModDir)')"
          ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(IntermediateAssemblyPdb);@(_DebugSymbolsIntermediatePath)"
          DestinationFolder="$(GamePlayerInfoModDir)"
          Condition="Exists('$(GamePlayerInfoModDir)')"
          ContinueOnError="true" />
    <Message Importance="high"
             Text="[PlayerInfo] 已自动部署 $(TargetFileName) → $(GamePlayerInfoModDir)"
             Condition="Exists('$(GamePlayerInfoModDir)')" />
    <Warning Text="[PlayerInfo] 游戏 Mod 目录不存在，跳过部署：$(GamePlayerInfoModDir)（请先创建该目录）"
             Condition="!Exists('$(GamePlayerInfoModDir)')" />
  </Target>

</Project>
