[
  {
    "Type": "SpeakDialogue",
    "name": "若有新招，尽管试来",
    "DialogueId": 320170001,
    "SubtitleDurationMs": 2500,
    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/lys_huanwuzhe/EVT_enm_lys_huanwuzhe_voice_dialogue_021",
