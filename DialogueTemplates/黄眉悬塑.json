    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_45",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_45"
  },
  {
    "Type": "SpeakDialogue",
    "name": "我有弟子三千，信众无数",
    "DialogueId": 339000106,
    "SubtitleDurationMs": 2500,
    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_46",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_46"
  },
  {
    "Type": "SpeakDialogue",
    "name": "皆为你准备，任你杀戮",
    "DialogueId": 339000107,
    "SubtitleDurationMs": 2500,
    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_46",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_46"
  },
  {
    "Type": "SpeakDialogue",
    "name": "六道众生谁无杀心？",
    "DialogueId": 339000108,
    "SubtitleDurationMs": 2500,
    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_47",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_47"
  },
  {
    "Type": "SpeakDialogue",
    "name": "何况天也杀人，地也杀人！",
    "DialogueId": 339000109,
    "SubtitleDurationMs": 2500,
    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_47",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_47"
  },
  {
    "Type": "SpeakDialogue",
    "name": "十方诸佛皆无心，你已与十方诸佛无异",
    "DialogueId": 339000110,
    "SubtitleDurationMs": 2500,
    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_48",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_48"
  },
  {
    "Type": "SpeakDialogue",
    "name": "老说什么放下放下",
