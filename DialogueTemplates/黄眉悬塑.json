    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_44",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_44"
  },
  {
    "Type": "SpeakDialogue",
    "name": "佛者，觉也",
