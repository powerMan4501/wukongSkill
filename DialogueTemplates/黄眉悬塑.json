    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_49",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_49"
  },
  {
    "Type": "SpeakDialogue",
    "name": "你放得下手里的屠刀，放得下心中的偶像吗？",
    "DialogueId": 339000112,
    "SubtitleDurationMs": 2500,
    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_49",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_49"
  },
  {
    "Type": "SpeakDialogue",
    "name": "你恶业深重，从一地狱历一地狱",
