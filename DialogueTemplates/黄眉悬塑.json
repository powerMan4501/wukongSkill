    "SubtitleDurationMs": 2500,
    "path": "/Game/00Main/Audio/SFX/Enemy/LYS/LYS_huangmei_03/Voice/EVT_lys_huangmei_voice_dialogue_50",
    "AkEventName": "EVT_lys_huangmei_voice_dialogue_50"
  },
  {
